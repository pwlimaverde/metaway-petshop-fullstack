# ----------------------------------------
# Docker remoto (SSH)
# ----------------------------------------
METAWAY_PETSHOP_DOCKER_HOST=ssh://user@host
DOCKER_HOST=ssh://user@host
COMPOSE_PROJECT_NAME=metaway-petshop

# ----------------------------------------
# API
# ----------------------------------------
APP_ENV=development
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

# ----------------------------------------
# PostgreSQL
# ----------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=metaway_petshop
POSTGRES_USER=metaway_petshop
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://metaway_petshop:change_me@db:5432/metaway_petshop

# ----------------------------------------
# JWT
# ----------------------------------------
JWT_SECRET_KEY=change_me_with_a_strong_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ----------------------------------------
# Seed inicial
# ----------------------------------------
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_CPF=00000000000
ADMIN_SEED_PASSWORD=change_me

# ----------------------------------------
# Uploads
# ----------------------------------------
UPLOAD_DIR=/app/storage
UPLOAD_MAX_SIZE_MB=5
